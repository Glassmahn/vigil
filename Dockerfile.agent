FROM node:20-alpine

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app
COPY agent/package.json agent/package-lock.json* agent/tsconfig.json ./
RUN npm ci && npm cache clean --force
COPY agent/src ./src
RUN mkdir -p /data && chown appuser:appgroup /data

EXPOSE 3001
USER appuser
CMD ["npm", "run", "start"]
